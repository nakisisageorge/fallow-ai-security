# fallow-ai-security Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# AI Verification (Optional)
# Enable with: aiVerification.enabled = true in .fallowrc.json
FALLOW_AI_API_KEY=your-api-key-here
FALLOW_AI_ENDPOINT=https://api.openai.com/v1  # Optional: custom endpoint for Ollama/Custom providers

# Example for Ollama (local):
# FALLOW_AI_ENDPOINT=http://localhost:11434/v1
# FALLOW_AI_API_KEY=ollama  # Ollama doesn't require a real key

# Example for OpenAI:
# FALLOW_AI_ENDPOINT=https://api.openai.com/v1
# FALLOW_AI_API_KEY=sk-...

# Example for Anthropic:
# FALLOW_AI_ENDPOINT=https://api.anthropic.com
# FALLOW_AI_API_KEY=sk-ant...